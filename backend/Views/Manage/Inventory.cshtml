@model System.Collections.Generic.List<WebBanSach.Models.Data.Sach>
@{ Layout = "~/Views/Shared/_Layout.cshtml"; ViewBag.Title = "Quản lý kho hàng"; }
<main class="container py-4"><h1 class="h3">Quản lý kho hàng</h1><nav class="nav nav-pills gap-2 my-3"><a class="nav-link @(ViewBag.Tab == "available" ? "active" : "")" href="@Url.Action("Inventory", new { tab = "available" })">Hàng tồn (số lượng &gt; 0)</a><a class="nav-link @(ViewBag.Tab == "restock" ? "active" : "")" href="@Url.Action("Inventory", new { tab = "restock" })">Hàng cần nhập (số lượng = 0)</a></nav><p>@Model.Count đầu sách</p>@Html.Partial("_Products", Model)</main>
