@{ Layout = "~/Views/Shared/_MasterLayout.cshtml"; ViewBag.Title = "Đơn hàng của tôi - WebBanSach"; }


    <!-- WebBanSach Header & Navigation -->
    

    <!-- Main Content -->
    <main class="container py-4">
        <!-- Breadcrumb -->
        <nav aria-label="breadcrumb" class="wbs-breadcrumbs">
            <a href="index.html" class="text-muted"><i class="fa fa-home me-1"></i>Trang chủ</a>
            <span class="mx-2 text-muted">/</span>
            <span class="text-dark fw-semibold">Đơn hàng của tôi</span>
        </nav>

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h4 class="fw-bold mb-0 text-dark">
                <i class="fa fa-history text-primary me-2"></i> Lịch sử & Theo dõi đơn hàng
            </h4>
            <button class="btn btn-outline-secondary btn-sm" onclick="loadOrders()" style="border-radius: 6px;">
                <i class="fa fa-refresh me-1"></i> Làm mới
            </button>
        </div>

        <div id="ordersLoading" class="wbs-card text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">Đang tải danh sách đơn hàng...</p>
        </div>

        <div id="ordersNotLoggedIn" class="wbs-card text-center py-5" style="display: none; max-width: 550px; margin: 0 auto;">
            <div class="mx-auto mb-3" style="width: 70px; height: 70px; border-radius: 50%; background: #e5f3ff; color: #0b74e5; display: flex; align-items: center; justify-content: center; font-size: 32px;">
                <i class="fa fa-user-circle-o"></i>
            </div>
            <h5 class="fw-bold text-dark">Vui lòng đăng nhập để xem đơn hàng</h5>
            <p class="text-muted small">Đăng nhập tài khoản của bạn để dễ dàng tra cứu lịch sử mua hàng và tiến độ vận chuyển.</p>
            <a href="login.html?redirect=tracking.html" class="btn btn-primary px-4 fw-semibold mt-2">
                <i class="fa fa-sign-in me-1"></i> Đăng nhập ngay
            </a>
        </div>

        <div id="ordersEmpty" class="wbs-card text-center py-5" style="display: none; max-width: 550px; margin: 0 auto;">
            <div class="mx-auto mb-3" style="width: 70px; height: 70px; border-radius: 50%; background: #f5f5fa; color: #808089; display: flex; align-items: center; justify-content: center; font-size: 32px;">
                <i class="fa fa-file-text-o"></i>
            </div>
            <h5 class="fw-bold text-dark">Bạn chưa có đơn đặt hàng nào!</h5>
            <p class="text-muted small">Tất cả các đơn mua sách thành công sẽ được lưu trữ và cập nhật trạng thái liên tục tại đây.</p>
            <a href="index.html" class="btn btn-primary px-4 fw-semibold mt-2">
                <i class="fa fa-shopping-basket me-1"></i> Mua sắm ngay
            </a>
        </div>

        <div id="ordersList" style="display: none;" class="d-flex flex-column gap-3">
            <!-- Render list of order cards -->
        </div>
    </main>

    <!-- Footer -->
    

    <!-- Bootstrap 5 JS Bundle -->
    
    
    
    

    <!-- Floating Back-To-Top Button -->
    <button id="btnBackToTop" class="wbs-back-to-top" title="Lên đầu trang" onclick="window.scrollTo({top: 0, behavior: 'smooth'})">
        <i class="fa fa-arrow-up"></i>
    </button>

@section Scripts {
<script>
        function getBadge(status) {
            switch(Number(status)) {
                case 0: return '<span class="badge bg-warning text-dark"><i class="fa fa-clock-o me-1"></i> Chờ xử lý</span>';
                case 1: return '<span class="badge bg-info text-dark"><i class="fa fa-cube me-1"></i> Đã đóng gói</span>';
                case 2: return '<span class="badge bg-primary"><i class="fa fa-truck me-1"></i> Đang giao</span>';
                case 3: return '<span class="badge bg-success"><i class="fa fa-check-circle me-1"></i> Đã giao</span>';
                case 4: return '<span class="badge bg-secondary"><i class="fa fa-ban me-1"></i> Đã hủy</span>';
                default: return '<span class="badge bg-secondary">Không xác định</span>';
            }
        }

        async function loadOrders() {
            const loading = document.getElementById('ordersLoading');
            const notLoggedIn = document.getElementById('ordersNotLoggedIn');
            const empty = document.getElementById('ordersEmpty');
            const list = document.getElementById('ordersList');

            loading.style.display = 'block';
            notLoggedIn.style.display = 'none';
            empty.style.display = 'none';
            list.style.display = 'none';

            try {
                const me = await api.getMe();
                if (!me || !me.isLoggedIn) {
                    loading.style.display = 'none';
                    notLoggedIn.style.display = 'block';
                    return;
                }

                const res = await api.getMyOrders();
                loading.style.display = 'none';

                if (res.isLoggedIn === false || !res.status) {
                    notLoggedIn.style.display = 'block';
                    return;
                }

                if (!res.data || res.data.length === 0) {
                    empty.style.display = 'block';
                    return;
                }

                list.style.display = 'flex';
                list.innerHTML = res.data.map(order => `
                    <section class="wbs-card p-3">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            ${getBadge(order.status)}
                            ${order.canCancel ? `<button class="btn btn-sm btn-outline-danger" onclick="cancelOrderPrompt(${order.id})">Hủy đơn #${order.id}</button>` : ''}
                        </div>
                        <div class="invoice-target" data-order-id="${order.id}">Đang tải hóa đơn...</div>
                    </section>`).join('');
                await Promise.all(Array.from(list.querySelectorAll('.invoice-target')).map(async target => {
                    try {
                        const response = await fetch('/Portal/Invoice?id=' + target.dataset.orderId, { credentials: 'include', cache: 'no-store' });
                        if (!response.ok) throw new Error('Không thể tải hóa đơn.');
                        target.innerHTML = await response.text();
                    } catch (error) { target.textContent = error.message; }
                }));

            } catch (err) {
                console.error(err);
                loading.innerHTML = `<div class="alert alert-danger">Lỗi tải dữ liệu: ${err.message}</div>`;
            }
        }

        async function cancelOrderPrompt(id) {
            if (!confirm(`Bạn có chắc chắn muốn hủy đơn hàng #${id} không? Hành động này không thể hoàn tác.`)) {
                return;
            }

            try {
                const res = await api.cancelOrder(id);
                if (res.status) {
                    showToast(res.message || "Đã hủy đơn thành công!");
                    loadOrders();
                } else {
                    alert(res.message || "Không thể hủy đơn hàng.");
                }
            } catch (err) {
                alert("Lỗi khi hủy đơn hàng: " + err.message);
            }
        }

        function setupBackToTop() {
            const btn = document.getElementById('btnBackToTop');
            if (!btn) return;
            window.addEventListener('scroll', () => {
                if (window.scrollY > 280) {
                    btn.classList.add('show');
                } else {
                    btn.classList.remove('show');
                }
            }, { passive: true });
        }

        document.addEventListener("DOMContentLoaded", () => {
            loadOrders();
            setupBackToTop();
        });
    </script>
}
