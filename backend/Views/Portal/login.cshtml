@{ Layout = "~/Views/Shared/_MasterLayout.cshtml"; ViewBag.Title = "Đăng nhập tài khoản - WebBanSach"; }


    <!-- WebBanSach Header & Navigation -->
    

    <main class="container py-4">
        <!-- Breadcrumb -->
        <nav aria-label="breadcrumb" class="wbs-breadcrumbs">
            <a href="index.html" class="text-muted"><i class="fa fa-home me-1"></i>Trang chủ</a>
            <span class="mx-2 text-muted">/</span>
            <span class="text-dark fw-semibold">Đăng nhập tài khoản</span>
        </nav>

        <div class="auth-wrapper narrow">
            <div class="auth-card">
                <div class="text-center mb-4">
                    <div class="auth-icon-circle">
                        <i class="fa fa-user-circle-o"></i>
                    </div>
                    <h3 class="fw-bold text-dark mb-1" style="font-size: 22px;">Xin chào quý khách</h3>
                    <p class="text-muted small">Đăng nhập để nhận ưu đãi thành viên và theo dõi đơn hàng</p>
                </div>

                <div id="loginAlert" class="alert alert-danger py-2 small" style="display: none;"></div>

                <form onsubmit="handleLogin(event)">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark" for="username">
                            <i class="fa fa-user me-1 text-muted"></i> Tên tài khoản / Email
                        </label>
                        <input type="text" id="username" class="form-control" placeholder="Nhập tên tài khoản hoặc email" required autofocus autocomplete="username">
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark" for="password">
                            <i class="fa fa-lock me-1 text-muted"></i> Mật khẩu
                        </label>
                        <div class="password-wrapper">
                            <input type="password" id="password" class="form-control" placeholder="Nhập mật khẩu của bạn" required autocomplete="current-password">
                            <button type="button" class="btn-toggle-eye" onclick="togglePass('password', this)" title="Hiện/ẩn mật khẩu">
                                <i class="fa fa-eye"></i>
                            </button>
                        </div>
                    </div>

                    <button type="submit" id="btnLoginSubmit" class="btn btn-primary w-100 py-2 fw-bold mt-2" style="border-radius: 8px;">
                        <i class="fa fa-sign-in me-1"></i> Đăng nhập
                    </button>
                </form>

                <div class="text-center mt-4 pt-3 border-top small text-muted">
                    Chưa có tài khoản WebBanSach? <a id="registerLinkBottom" href="register.html" class="text-primary fw-bold text-decoration-none">Đăng ký ngay <i class="fa fa-angle-right"></i></a>
                </div>
            </div>
        </div>
    </main>

    <!-- Footer -->
    

    <!-- Bootstrap 5 JS Bundle -->
    
    
    

@section Scripts {
<script>
        function togglePass(id, btn) {
            const input = document.getElementById(id);
            const icon = btn.querySelector('i');
            if (input.type === 'password') {
                input.type = 'text';
                icon.className = 'fa fa-eye-slash';
            } else {
                input.type = 'password';
                icon.className = 'fa fa-eye';
            }
        }

        document.addEventListener("DOMContentLoaded", async () => {
            const urlParams = new URLSearchParams(window.location.search);
            const redirect = urlParams.get('redirect');
            if (redirect) {
                sessionStorage.setItem('authRedirect', redirect);
                const regNav = document.getElementById('registerLinkNav');
                const regBottom = document.getElementById('registerLinkBottom');
                if (regNav) regNav.href = `register.html?redirect=${encodeURIComponent(redirect)}`;
                if (regBottom) regBottom.href = `register.html?redirect=${encodeURIComponent(redirect)}`;
            }

            // If user is already logged in, send them straight to destination
            try {
                const me = await api.getMe();
                if (me.isLoggedIn) {
                    let target = redirect || sessionStorage.getItem('authRedirect') || 'index.html';
                    sessionStorage.removeItem('authRedirect');
                    if (target.includes('login.html') || target.includes('register.html') || target.includes('verify-email.html')) {
                        target = 'index.html';
                    }
                    window.location.href = target;
                }
            } catch (e) {}
        });

        async function handleLogin(e) {
            e.preventDefault();
            const u = document.getElementById('username').value.trim();
            const p = document.getElementById('password').value;
            const alertBox = document.getElementById('loginAlert');
            const submitBtn = document.getElementById('btnLoginSubmit');

            alertBox.style.display = 'none';
            submitBtn.disabled = true;
            submitBtn.innerHTML = `<i class="fa fa-spinner fa-spin"></i> Đang xử lý...`;

            try {
                const res = await api.login(u, p);
                if (res.status) {
                    if (res.requireOtp) {
                        sessionStorage.setItem('pendingEmail', res.email || '');
                        window.location.href = "verify-email.html";
                    } else {
                        showToast(`Chào mừng trở lại, ${res.user.name || res.user.username}!`);
                        setTimeout(() => {
                            const urlParams = new URLSearchParams(window.location.search);
                            let target = urlParams.get('redirect') || sessionStorage.getItem('authRedirect') || 'index.html';
                            sessionStorage.removeItem('authRedirect');
                            if (target.includes('login.html') || target.includes('register.html') || target.includes('verify-email.html')) {
                                target = 'index.html';
                            }
                            window.location.href = target;
                        }, 400);
                    }
                } else {
                    alertBox.textContent = res.message || "Tài khoản hoặc mật khẩu không chính xác.";
                    alertBox.style.display = 'block';
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = `<i class="fa fa-sign-in me-1"></i> Đăng nhập`;
                }
            } catch (err) {
                alertBox.textContent = "Không thể kết nối đến máy chủ.";
                alertBox.style.display = 'block';
                submitBtn.disabled = false;
                submitBtn.innerHTML = `<i class="fa fa-sign-in me-1"></i> Đăng nhập`;
            }
        }
    </script>
}
