                <div class="wbs-logo-icon">
                    <i class="fa fa-book"></i>
                </div>
                <div>
                    <div class="wbs-logo-text">WEBBANSACH</div>
                    <span class="wbs-logo-slogan d-none d-sm-block">Tốt & Nhanh • 100% Chính hãng</span>
