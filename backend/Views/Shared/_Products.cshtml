@model System.Collections.Generic.List<WebBanSach.Models.Data.Sach>
<div class="table-responsive"><table class="table bg-white align-middle"><thead><tr><th>Sách</th><th>Ảnh</th><th>Giá</th><th>Tồn kho</th><th>Thể loại</th></tr></thead><tbody>
@foreach (var b in Model) { <tr><td><a href="@Url.Action("Product", "Portal", new { id = b.MaSach })">@b.TenSach</a></td><td><img src="@Url.Content("~/images/" + (b.AnhBia ?? "topSach.png"))" width="45" height="60" style="object-fit:contain" alt="@b.TenSach" /></td><td>@b.GiaSauGiam.ToString("N0") VND</td><td>@(b.SoLuongTon ?? 0)</td><td>@(b.TheLoai == null ? "" : b.TheLoai.TenLoai)</td></tr> }
</tbody></table></div>
@if (Model.Count == 0) { <p class="text-muted">Không có sản phẩm trong danh sách này.</p> }
