@model WebBanSach.Models.ProductDetailsModel
@{ var b = Model.Book; }
<article class="wbs-card p-4" data-partial="product-details">
    <div class="row g-4">
        <div class="col-md-5 text-center"><img src="@Url.Content("~/images/" + (b.AnhBia ?? "topSach.png"))" alt="@b.TenSach" class="img-fluid" style="max-height:340px;object-fit:contain" /></div>
        <div class="col-md-7">
            <h2 class="h4">@b.TenSach</h2>
            <dl class="row small">
                <dt class="col-4">Mã sách</dt><dd class="col-8">@b.MaSach</dd>
                <dt class="col-4">Tác giả</dt><dd class="col-8">@(b.TacGia == null ? "Chưa cập nhật" : b.TacGia.TenTG)</dd>
                <dt class="col-4">Thể loại</dt><dd class="col-8">@(b.TheLoai == null ? "Chưa cập nhật" : b.TheLoai.TenLoai)</dd>
                <dt class="col-4">Nhà xuất bản</dt><dd class="col-8">@(b.NhaXuatBan == null ? "Chưa cập nhật" : b.NhaXuatBan.TenNXB)</dd>
                <dt class="col-4">Dịch giả</dt><dd class="col-8">@(b.NguoiDich ?? "Chưa cập nhật")</dd>
                <dt class="col-4">Tồn kho</dt><dd class="col-8">@(b.SoLuongTon ?? 0)</dd>
                <dt class="col-4">Đánh giá</dt><dd class="col-8">@Model.Rating.ToString("0.0") / 5 (@Model.ReviewCount đánh giá)</dd>
            </dl>
            <p class="h4 text-danger">@b.GiaSauGiam.ToString("N0") VND</p>
            @if (b.GiamGia > 0) { <p><del>@b.GiaBan.GetValueOrDefault().ToString("N0") VND</del> <span class="badge bg-danger">-@b.GiamGia%</span></p> }
            @if (!Model.IsAdmin) {
                <div class="d-flex gap-2 my-3 align-items-center">
                    <label for="qtyInput">Số lượng</label>
                    <input id="qtyInput" type="number" min="1" max="@Math.Min(999L, b.SoLuongTon ?? 0)" value="1" class="form-control" style="max-width:100px" oninput="normalizeQty(this)" disabled="@((b.SoLuongTon ?? 0) <= 0 ? "disabled" : null)" />
                    <button type="button" class="btn btn-danger" onclick="addToCartDetail(@b.MaSach)" disabled="@((b.SoLuongTon ?? 0) <= 0 ? "disabled" : null)">Thêm vào giỏ</button>
                </div>
            }
        </div>
    </div>
    <h3 class="h6 mt-4">Mô tả sách</h3><div style="white-space:pre-wrap;overflow-wrap:anywhere">@(b.Mota ?? "Chưa có mô tả.")</div>
</article>
